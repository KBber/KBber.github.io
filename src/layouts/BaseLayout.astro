---
import '@styles/global.css';
import '@styles/taste-motion.css';
import SITE_CONFIG from '../../site.config';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import sand from '../../assets/plates/sand-texture.png';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeNav?: string;
  home?: boolean;
}
const {
  title,
  description = SITE_CONFIG.seo.description,
  ogImage = SITE_CONFIG.seo.ogImage,
  activeNav,
  home = false,
} = Astro.props;
const fullTitle = title
  ? SITE_CONFIG.seo.titleTemplate.replace('%s', title)
  : SITE_CONFIG.brand.name + ' · ' + SITE_CONFIG.brand.tagline;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://kbber.github.io').href;
---

<!doctype html>
<html lang="zh-CN" data-type="software" data-buttons="solid" data-motion="live" class:list={{ 'home-page': home }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="KBber" />
    <meta name="generator" content={Astro.generator} />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#15120f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? canonicalURL).href} />
    <meta property="og:url" content={canonicalURL} />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        if (!document.documentElement.classList.contains('home-page') && localStorage.getItem('kbber-theme') === 'light') {
          document.documentElement.classList.add('light-mode');
        }
      } catch {}
    </script>
  </head>
  <body style={`--sand-texture: url("${sand.src}")`}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Navbar active={activeNav} home={home} />
    <main id="main"><slot /></main>
    <Footer home={home} />
    <script>
      import '../scripts/taste-motion.js';
    </script>
  </body>
</html>
