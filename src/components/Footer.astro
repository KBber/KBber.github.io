---
import SITE_CONFIG from '../../site.config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="socials">
    {SITE_CONFIG.social.github && (
      <a href={SITE_CONFIG.social.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2.2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.4-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
      </a>
    )}
    {SITE_CONFIG.social.email && (
      <a href={SITE_CONFIG.social.email} aria-label="Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      </a>
    )}
  </div>
  <div>
    {SITE_CONFIG.footer.copyright.replace(/\d{4}/, String(year))} ·
    <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a>
  </div>
  {SITE_CONFIG.footer.poweredBy && (
    <div style="margin-top:6px;opacity:0.7">{SITE_CONFIG.footer.poweredBy}</div>
  )}
</footer>
