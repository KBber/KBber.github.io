---
import ThemeToggle from './ThemeToggle.astro';
const year = new Date().getFullYear();
interface Props { home?: boolean; }
const { home = false } = Astro.props;
---

<footer class="footer">
  <div class="footer-inner">
    <a class="footer-brand" href="/">KBber</a>
    <nav aria-label="页脚">
      <a href="/projects/">项目</a>
      <a href="/posts/">文章</a>
      <a href="/notes/">笔记</a>
      <a href="/albums/">相册</a>
      <a href="/moments/">随笔</a>
      <a href="/about/">关于</a>
      <a href="/rss.xml">RSS</a>
      <a href="https://github.com/KBber">GitHub</a>
    </nav>
    <div class="footer-meta"><span>© {year} KBber</span><span>Astro</span>{!home && <ThemeToggle />}</div>
  </div>
</footer>
