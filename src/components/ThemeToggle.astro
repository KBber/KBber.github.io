---
// Theme toggle — works with the bootstrap script in BaseLayout.astro.
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<script>
  const KEY = 'kbber-theme';
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  function currentLight() {
    return root.classList.contains('light-mode');
  }

  btn?.addEventListener('click', () => {
    const next = currentLight() ? 'dark' : 'light';
    if (next === 'light') root.classList.add('light-mode');
    else root.classList.remove('light-mode');
    try { localStorage.setItem(KEY, next); } catch {}
  });

  // React to system changes only if user hasn't picked a manual preference
  const mq = window.matchMedia('(prefers-color-scheme: light)');
  const onChange = () => {
    try {
      if (localStorage.getItem(KEY)) return;
      if (mq.matches) root.classList.add('light-mode');
      else root.classList.remove('light-mode');
    } catch {}
  };
  mq.addEventListener?.('change', onChange);
</script>
