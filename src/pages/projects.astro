---
import BaseLayout from '@layouts/BaseLayout.astro';

interface Project {
  id: string;
  title: string;
  subtitle: string;
  body: string;
  href: string;
  tags: string[];
  accent: string;
  pinned?: boolean;
}

const projects: Project[] = [
  {
    id: 'tenderguard',
    title: 'TenderGuard v0.3',
    subtitle: 'Evidence-Grounded, Rule-Governed Tender Compliance System',
    body: 'LLM 理解招标文件 + Codeified Rule Engine + Evidence Pipeline + Human Review。61 条 CK、17 个确定性算子、AuditReport 三级 trace，spec §七/§八/§十严守 Rule 优先 / 缺证据不 FAIL / 无 LLM 自循环。',
    href: 'https://github.com/KBber/tenderguard',
    tags: ['Agent', 'Rule Engine', 'Pydantic v2', 'PyMuPDF'],
    accent: '#06B6D4',
    pinned: true,
  },
  {
    id: 'pd-grpo',
    title: 'pd-grpo',
    subtitle: 'Nash Equilibrium via GRPO on Iterated Prisoner’s Dilemma',
    body: '用 GRPO 微调 Qwen2-0.5B，从 Tit-for-Tat 老好人收敛到 Always-Defect 理性人，300 步全训练过程 + 5 张数据图，复现指引 + 工程翻车记录。',
    href: 'https://github.com/KBber/pd-grpo',
    tags: ['GRPO', 'RL', 'PyTorch', 'Qwen2-0.5B'],
    accent: '#7C3AED',
    pinned: true,
  },
  {
    id: 'graphrag',
    title: 'graphrag-financial-report',
    subtitle: 'Typed GraphRAG over Chinese Annual Reports',
    body: 'DeepSeek 三元组抽取 → Neo4j 知识图谱 → Leiden 社区检测 → Local/Global Search 双模式检索，15 个固定问题对比 GraphRAG 与向量 RAG 的取舍。',
    href: 'https://github.com/KBber/graphrag-financial-report',
    tags: ['GraphRAG', 'Neo4j', 'Leiden', 'FastAPI'],
    accent: '#0EA5E9',
    pinned: true,
  },
  {
    id: 'react-llm-memory',
    title: 'react-llm-memory-agent',
    subtitle: 'ReAct Agent with Persistent Short-Term Memory',
    body: 'ReAct 双实现（手写 Prompt vs Function Calling）+ 实体追踪 + 指代消解（对比类 / 重复类）+ Web UI + 36 个单元测试 + 端到端集成，金融年报多轮问答场景。',
    href: 'https://github.com/KBber/react-llm-memory-agent',
    tags: ['ReAct', 'Function Calling', 'Memory', 'Anaphora'],
    accent: '#22C55E',
    pinned: true,
  },
  {
    id: 'contextual-retrieval',
    title: 'contextual-retrieval-for-user-memory',
    subtitle: 'Experiment 3-11: Contextual RAG + Advanced JSON Cards',
    body: '《深入理解 AI Agent》第 3 章配套实现 — 双层记忆（上下文检索 + JSON Cards）+ 60 case campaign + 凭证免费 receipt。',
    href: 'https://github.com/KBber/contextual-retrieval-for-user-memory',
    tags: ['Contextual RAG', 'Memory', 'LLM-as-Judge'],
    accent: '#14B8A6',
  },
  {
    id: 'chinese-ner',
    title: 'chinese-ner-sequence-labeling',
    subtitle: 'A Four-Paradigm Sequence Labeling Study',
    body: 'BERT+Linear / BERT+CRF / Qwen-Plus API / Qwen2-0.5B+LoRA — 四个范式在 CLUENER2020 与 People's Daily 上的系统对比。',
    href: 'https://github.com/KBber/chinese-ner-sequence-labeling',
    tags: ['NER', 'BERT', 'CRF', 'LoRA'],
    accent: '#14B8A6',
  },
  {
    id: 'edgeai',
    title: 'edgeai-trash-classifier',
    subtitle: 'Lightweight Edge-AI Garbage Classification',
    body: 'MobileNetV2 / ResNet 训练 245 类垃圾分类 + PyTorch Mobile + Android CameraX 端侧部署，约 50–80ms 推理。',
    href: 'https://github.com/KBber/edgeai-trash-classifier',
    tags: ['Edge AI', 'MobileNetV2', 'Android', 'PyTorch Mobile'],
    accent: '#F59E0B',
  },
  {
    id: 's2dl',
    title: 'S2DL',
    subtitle: 'Superpixel-based Spatially-regularized Diffusion Learning',
    body: '超像素 + 空间正则化扩散学习，用于无监督高光谱图像聚类，论文配套实现。',
    href: 'https://github.com/KBber/S2DL',
    tags: ['Diffusion', 'Superpixel', 'Hyperspectral'],
    accent: '#A855F7',
  },
];

const pinned = projects.filter((p) => p.pinned);
const others = projects.filter((p) => !p.pinned);
---

<BaseLayout
  title="Projects"
  description="KBber's engineering projects — Agent systems, GraphRAG, GRPO/RLHF, Chinese NER, edge AI."
  activeNav="/projects"
>
  <section class="hero" style="padding-top: 24px;">
    <div class="hero-card liquid-glass">
      <span class="liquid-glass-pill">// Projects</span>
      <h1 class="hero-greeting" style="font-size: 28px;">我做过的工程</h1>
      <p class="hero-tagline">
        围绕 Agent · LLM · RL 的完整作品集。Hero 项目是当前主线，其他是路过的风景。
      </p>
    </div>

    <section>
      <h2 class="section-title">// ⭐ Featured</h2>
      <div class="project-grid">
        {pinned.map((p) => (
          <a class="liquid-glass project-card" href={p.href} target="_blank" rel="noopener"
             style={`--accent: ${p.accent};`}>
            <div class="project-head">
              <h3>{p.title}</h3>
              <span class="pinned-badge">PINNED</span>
            </div>
            <p class="project-sub">{p.subtitle}</p>
            <p class="project-body">{p.body}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <span class="project-link">GitHub ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="section-title">// 其他项目</h2>
      <div class="project-grid">
        {others.map((p) => (
          <a class="liquid-glass project-card" href={p.href} target="_blank" rel="noopener"
             style={`--accent: ${p.accent};`}>
            <div class="project-head">
              <h3>{p.title}</h3>
            </div>
            <p class="project-sub">{p.subtitle}</p>
            <p class="project-body">{p.body}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <span class="project-link">GitHub ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="section-title">// 全部仓库</h2>
      <p style="color: var(--ink-2);">
        完整列表见 <a href="https://github.com/KBber?tab=repositories" target="_blank" rel="noopener" style="color: var(--accent-soft);">github.com/KBber</a>。
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
  }
  .project-card {
    display: block;
    padding: 18px 20px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    border-left: 3px solid var(--accent, var(--accent-soft));
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }
  .project-head h3 { font-size: 17px; margin: 0; }
  .pinned-badge {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: white;
    letter-spacing: 0.5px;
  }
  .project-sub {
    color: var(--ink-2);
    font-size: 13px;
    margin: 4px 0 8px;
  }
  .project-body {
    color: var(--ink);
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 10px;
  }
  .project-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.18);
    color: var(--ink-2);
    border: 1px solid rgba(148, 163, 184, 0.25);
  }
  .project-link {
    display: inline-block;
    font-size: 13px;
    color: var(--accent-soft);
  }
</style>