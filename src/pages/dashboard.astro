---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '@layouts/BaseLayout.astro';
import DashboardGrid from '@components/dashboard/DashboardGrid';

const dataDir = path.resolve(process.cwd(), 'src/data');
const repos = JSON.parse(await readFile(path.join(dataDir, 'projects.json'), 'utf8'));

const totalRepos = repos.length;
const totalStars = repos.reduce((s: number, r: any) => s + (r.stargazers_count || 0), 0);
const totalOpenIssues = repos.reduce((s: number, r: any) => s + (r.open_issues_count || 0), 0);
const withActions = repos.filter((r: any) => r.has_actions).length;

// Try to load manifest summaries for the dashboard
type ManifestSummary = { ai_instructions?: { update_policy?: string } } | null;
let manifestsBySlug: Record<string, ManifestSummary> = {};
try {
  const schemaDir = path.resolve(process.cwd(), 'schemas');
  for (const r of repos) {
    try {
      // Read manifest from raw GitHub; this is a build-time check (only fires once per build).
      // No token required; rate-limit only kicks in after 60 un-authed calls.
      const url = `https://raw.githubusercontent.com/KBber/${r.slug}/main/PROJECT_CONTEXT.json`;
      const resp = await fetch(url);
      if (resp.ok) {
        manifestsBySlug[r.slug] = await resp.json();
      }
    } catch {}
  }
} catch (e) {
  console.warn('manifest preload failed', e);
}
---

<BaseLayout
  title="Git 仪表盘"
  description="KBber 多仓库可视化仪表盘 — 分支、提交链、AI 契约、回滚助手。"
  activeNav="/dashboard"
>
  <section class="hero" style="padding-top: 24px;">
    <div class="hero-card liquid-glass">
      <span class="liquid-glass-pill">📊 Git 仪表盘</span>
      <h1 class="hero-greeting" style="font-size: 28px;">多仓库可视化</h1>
      <p class="hero-tagline">
        所有 KBber 项目的当前分支、最近提交、AI 契约、回滚助手 — 一页看完。
      </p>
      <div class="dash-stats">
        <div class="dash-stat">
          <span class="dash-stat-n">{totalRepos}</span>
          <span class="dash-stat-l">项目</span>
        </div>
        <div class="dash-stat">
          <span class="dash-stat-n">{totalStars}</span>
          <span class="dash-stat-l">⭐ Stars</span>
        </div>
        <div class="dash-stat">
          <span class="dash-stat-n">{withActions}</span>
          <span class="dash-stat-l">⚙ CI</span>
        </div>
        <div class="dash-stat">
          <span class="dash-stat-n">{totalOpenIssues}</span>
          <span class="dash-stat-l">📌 Issues</span>
        </div>
      </div>
    </div>

    <section>
      <h2 class="section-title">// 所有项目</h2>
      <DashboardGrid client:load repos={repos} manifests={manifestsBySlug} />
    </section>

    <section>
      <h2 class="section-title">// AI 契约说明</h2>
      <div class="liquid-glass" style="padding: 18px 22px;">
        <p>
          每个 KBber 项目在 <code>main</code> 分支根目录携带一份 <code>PROJECT_CONTEXT.json</code>。
          AI 可以 <code>curl https://raw.githubusercontent.com/KBber/&lt;repo&gt;/main/PROJECT_CONTEXT.json | jq .</code>
          直接拿到项目状态、更新策略、回滚策略与预制 prompt。
        </p>
        <p style="margin-top: 8px;">
          Schema 定义见 <code>schemas/project-context.schema.json</code>，本地生成器见{' '}
          <code>tools/bootstrap_project_context.py</code>。
        </p>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .dash-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .dash-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .dash-stat-n { font-size: 22px; font-weight: 700; color: var(--accent); }
  .dash-stat-l { font-size: 12px; color: var(--ink-2); margin-top: 2px; }

  /* RepoCard */
  .repo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .repo-card {
    display: block;
    padding: 18px 20px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    border-left: 3px solid var(--accent);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .repo-card:hover { transform: translateY(-2px); border-color: var(--accent-deep); }
  .repo-card-head {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    margin-bottom: 8px;
  }
  .repo-card-title { display: flex; align-items: baseline; gap: 6px; }
  .repo-card-title h3 { font-size: 17px; margin: 0; }
  .repo-card-slug { color: var(--ink-2); font-size: 12px; }
  .policy-badge {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 999px;
    color: white;
    white-space: nowrap;
  }
  .repo-card-desc {
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1.5;
    margin: 6px 0 12px;
    min-height: 38px;
  }
  .repo-card-meta {
    display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px;
  }
  .meta-chip {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.18);
    color: var(--ink-2);
    border: 1px solid rgba(148, 163, 184, 0.22);
  }
  .meta-chip code { font-size: 11px; color: var(--ink); }
  .repo-card-footer {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 13px;
  }
  .card-link { color: var(--accent-soft); }
  .card-link-soft { color: var(--ink-2); font-size: 12px; }

  /* Filters */
  .dashboard-filters {
    display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
    padding: 14px 18px; margin-bottom: 14px; border-radius: 14px;
  }
  .filter-search {
    flex: 1 1 220px;
    background: rgba(255,255,255,0.06);
    color: var(--ink);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 6px 10px;
    outline: none;
  }
  .filter-select {
    background: rgba(255,255,255,0.06);
    color: var(--ink);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .filter-policies { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-chip {
    background: rgba(255,255,255,0.04);
    color: var(--ink-2);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 12px;
    cursor: pointer;
  }
  .filter-chip.is-active {
    background: var(--accent);
    color: white;
    border-color: transparent;
  }
  .filter-count {
    color: var(--ink-2);
    font-size: 12px;
    margin-left: auto;
  }
  .empty-hint {
    text-align: center;
    color: var(--ink-2);
    padding: 30px;
  }
</style>