---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '@layouts/BaseLayout.astro';
import RepoTimeline from '@components/dashboard/RepoTimeline';
import CommitChain from '@components/dashboard/CommitChain';
import RollbackHelper from '@components/dashboard/RollbackHelper';
import CiStatusBadge from '@components/dashboard/CiStatusBadge';
import BranchList from '@components/dashboard/BranchList';
import OpenIssuesList from '@components/dashboard/OpenIssuesList';
import ContributorsList from '@components/dashboard/ContributorsList';
import ProjectManifestPanel from '@components/dashboard/ProjectManifestPanel';
import { accentFor, timeAgo, POLICY_BADGES } from '../../lib/manifest';

const dataDir = path.resolve(process.cwd(), 'src/data');
const projectsList = JSON.parse(await readFile(path.join(dataDir, 'projects.json'), 'utf8'));

export async function getStaticPaths() {
  const dataDir = path.resolve(process.cwd(), 'src/data');
  const projectsList = JSON.parse(await readFile(path.join(dataDir, 'projects.json'), 'utf8'));
  return projectsList.map((r: any) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const snapshot = JSON.parse(await readFile(path.join(dataDir, 'snapshots', `${slug}.json`), 'utf8'));
const repo = snapshot.repo;
const accent = accentFor(slug);

// Fetch manifest raw + validate via a small inline zod-like check at build time.
// (We avoid pulling zod into server context; client-side panel does the canonical validation.)
let manifest: any = null;
let manifestRaw: any = null;
let manifestValid = false;
try {
  const url = `https://raw.githubusercontent.com/KBber/${slug}/main/PROJECT_CONTEXT.json`;
  const resp = await fetch(url);
  if (resp.ok) {
    manifestRaw = await resp.json();
    // Minimal sanity check: required keys present.
    const required = ['schema_version', 'name', 'slug', 'owner', 'summary', 'stack', 'state', 'ai_instructions'];
    manifestValid = required.every((k) => k in (manifestRaw ?? {}));
    manifest = manifestValid ? manifestRaw : null;
  }
} catch {}
---

<BaseLayout
  title={repo.name}
  description={repo.description ?? `KBber/${repo.slug} project detail`}
  activeNav="/projects"
>
  <section class="hero" style="padding-top: 24px;">
    <!-- Header -->
    <div class="liquid-glass detail-header" style={`--accent: ${accent};`}>
      <div class="detail-header-main">
        <span class="liquid-glass-pill">📦 Git Project</span>
        <h1 class="hero-greeting" style="font-size: 28px;">
          <a href={repo.html_url} target="_blank" rel="noopener" class="gh-name">{repo.name}</a>
          <span class="gh-slug">/{repo.slug}</span>
        </h1>
        <p class="hero-tagline">{repo.description || '—'}</p>
        <div class="detail-stats">
          <span>⭐ {repo.stargazers_count}</span>
          <span>👀 {repo.watchers_count}</span>
          <span>📌 {repo.open_issues_count}</span>
          <span>🌿 <code>{repo.default_branch}</code></span>
          {repo.language && <span>📝 {repo.language}</span>}
          <span>⏱ pushed {timeAgo(repo.pushed_at)}</span>
          {repo.fork && <span>🍴 fork</span>}
          {repo.archived && <span>📦 archived</span>}
          {manifest && (
            <span class="manifest-valid-badge">✅ manifest {manifest.schema_version}</span>
          )}
        </div>
      </div>
    </div>

    <!-- Manifest panel -->
    <section>
      <h2 class="section-title">// PROJECT_CONTEXT</h2>
      <ProjectManifestPanel client:load manifest={manifest} raw={manifestRaw} slug={slug} />
    </section>

    <!-- Timeline -->
    <section>
      <h2 class="section-title">// 最近提交</h2>
      <div class="liquid-glass detail-block">
        <RepoTimeline client:load slug={slug} commits={snapshot.commits} />
      </div>
    </section>

    <!-- Full commit table -->
    <section>
      <h2 class="section-title">// 完整 commit 链</h2>
      <div class="liquid-glass detail-block">
        <CommitChain client:load slug={slug} commits={snapshot.commits} />
      </div>
    </section>

    <!-- Branches -->
    <section>
      <h2 class="section-title">// 分支</h2>
      <div class="liquid-glass detail-block">
        <BranchList client:load branches={snapshot.branches} current={repo.default_branch} />
      </div>
    </section>

    <!-- CI -->
    <section>
      <h2 class="section-title">// CI 状态</h2>
      <div class="liquid-glass detail-block">
        <CiStatusBadge client:load runs={snapshot.actions} />
      </div>
    </section>

    <!-- Issues -->
    <section>
      <h2 class="section-title">// Open Issues</h2>
      <div class="liquid-glass detail-block">
        <OpenIssuesList client:load issues={snapshot.issues} slug={slug} />
      </div>
    </section>

    <!-- Contributors -->
    <section>
      <h2 class="section-title">// 贡献者</h2>
      <div class="liquid-glass detail-block">
        <ContributorsList client:load contributors={snapshot.contributors} />
      </div>
    </section>

    <!-- AI instructions -->
    {manifest && (
      <section>
        <h2 class="section-title">// AI 指令卡</h2>
        <div class="liquid-glass detail-block">
          <div class="ai-grid">
            <div class="ai-cell">
              <span class="ai-label">更新策略</span>
              <strong>
                {POLICY_BADGES[manifest.ai_instructions.update_policy]?.icon}{' '}
                {POLICY_BADGES[manifest.ai_instructions.update_policy]?.label}
              </strong>
            </div>
            <div class="ai-cell">
              <span class="ai-label">回滚策略</span>
              <strong><code>{manifest.ai_instructions.rollback_policy.default_strategy}</code></strong>
            </div>
            <div class="ai-cell">
              <span class="ai-label">需要确认</span>
              <strong>{String(manifest.ai_instructions.rollback_policy.require_confirmation)}</strong>
            </div>
            <div class="ai-cell">
              <span class="ai-label">别名映射</span>
              <strong>{Object.keys(manifest.ai_instructions.aliases ?? {}).length} 个</strong>
            </div>
          </div>
          {manifest.ai_instructions.prompts && (
            <div class="ai-prompts">
              {(['summarize', 'next_step', 'rollback'] as const).map((k) => (
                manifest.ai_instructions.prompts[k] && (
                  <details class="ai-prompt">
                    <summary>💬 prompt.{k}</summary>
                    <pre>{manifest.ai_instructions.prompts[k]}</pre>
                  </details>
                )
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Rollback helper -->
    <section>
      <h2 class="section-title">// 回滚助手</h2>
      <RollbackHelper client:load manifest={manifest} commits={snapshot.commits} defaultBranch={repo.default_branch} />
    </section>

    <section>
      <h2 class="section-title">// 数据快照</h2>
      <p class="muted">
        数据采集于 <code>{snapshot.snapshot_at}</code>。每 6h 自动刷新；点击
        <a href="/dashboard">📊 仪表盘</a> 上的 🔄 可手动 revalidate。
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .detail-header {
    display: flex; gap: 18px; align-items: center;
    padding: 20px 22px;
    border-left: 3px solid var(--accent);
  }
  .detail-header-main { flex: 1; }
  .gh-name { color: var(--ink); text-decoration: none; }
  .gh-slug { color: var(--ink-2); font-size: 14px; margin-left: 6px; }
  .detail-stats {
    display: flex; flex-wrap: wrap; gap: 12px;
    font-size: 13px; color: var(--ink-2); margin-top: 8px;
  }
  .manifest-valid-badge {
    background: rgba(34, 197, 94, 0.16);
    color: #22C55E;
    border: 1px solid rgba(34, 197, 94, 0.35);
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 12px;
  }
  .detail-block { padding: 18px 22px; }

  /* AI grid */
  .ai-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }
  .ai-cell {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex; flex-direction: column;
  }
  .ai-label { font-size: 12px; color: var(--ink-2); margin-bottom: 4px; }
  .ai-cell strong { font-size: 14px; }
  .ai-prompts details {
    background: rgba(0,0,0,0.18);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 8px;
  }
  .ai-prompts summary { cursor: pointer; font-weight: 600; }
  .ai-prompts pre {
    margin-top: 8px;
    white-space: pre-wrap;
    font-size: 12px;
    color: var(--ink-2);
  }

  /* RepoTimeline */
  .repo-timeline { padding: 4px 0; }
  .timeline-day { margin-bottom: 12px; }
  .day-label {
    font-size: 11px; color: var(--ink-2);
    text-transform: uppercase; letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .timeline-list { list-style: none; padding: 0; margin: 0; }
  .timeline-item {
    display: flex; gap: 10px; padding: 8px 0;
    border-left: 2px solid rgba(148, 163, 184, 0.18);
    padding-left: 12px; margin-left: 4px;
    position: relative;
  }
  .timeline-dot {
    position: absolute;
    left: -5px; top: 12px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .commit-sha code {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--accent-soft);
  }
  .commit-sha { text-decoration: none; }
  .commit-msg { font-size: 13px; line-height: 1.5; margin-top: 4px; }
  .commit-author { font-size: 11px; color: var(--ink-2); margin-top: 4px; display: flex; gap: 6px; }
  .timeline-more {
    width: 100%; padding: 8px;
    background: rgba(255,255,255,0.04);
    color: var(--accent);
    border: 1px dashed rgba(255,255,255,0.12);
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
  }

  /* CommitChain */
  .commit-chain table {
    width: 100%; border-collapse: collapse; font-size: 13px;
  }
  .commit-chain th, .commit-chain td {
    text-align: left; padding: 6px 10px;
    border-bottom: 1px dashed rgba(148, 163, 184, 0.16);
  }
  .commit-chain th {
    color: var(--ink-2); font-weight: 500; font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .commit-chain code { color: var(--accent-soft); }
  .commit-msg-cell { max-width: 480px; }

  /* BranchList */
  .branch-pills { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .branch-pill {
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.22);
    font-size: 12px;
  }
  .branch-pill code { color: var(--ink); font-size: 12px; }
  .branch-pill.is-current {
    background: var(--accent); color: white; border-color: transparent;
  }
  .branch-pill.is-current code { color: white; }
  .branch-tag { font-size: 9px; margin-left: 6px; opacity: 0.85; letter-spacing: 0.5px; }

  /* CI */
  .ci-list { display: flex; flex-direction: column; gap: 8px; }
  .ci-row {
    display: grid;
    grid-template-columns: 12px 1fr auto auto;
    gap: 10px; align-items: center;
    padding: 8px 12px;
    border-radius: 8px;
    background: rgba(255,255,255,0.04);
    text-decoration: none;
    color: var(--ink);
    border: 1px solid rgba(255,255,255,0.04);
  }
  .ci-dot { width: 10px; height: 10px; border-radius: 50%; background: #94A3B8; }
  .ci-row.is-ok .ci-dot { background: #22C55E; }
  .ci-row.is-fail .ci-dot { background: #EF4444; }
  .ci-row.is-pending .ci-dot { background: #F59E0B; animation: ci-pulse 1.2s infinite; }
  @keyframes ci-pulse { 50% { opacity: 0.4; } }
  .ci-name { font-size: 13px; font-weight: 500; }
  .ci-meta { font-size: 11px; color: var(--ink-2); display: flex; gap: 8px; }
  .ci-state { font-size: 11px; color: var(--ink-2); }

  /* Issues */
  .issue-list { list-style: none; padding: 0; margin: 0; }
  .issue-row a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px; align-items: center;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid rgba(255,255,255,0.04);
    margin-bottom: 4px;
  }
  .issue-row a:hover { background: rgba(255,255,255,0.04); }
  .issue-number { color: var(--accent-soft); font-size: 13px; }
  .issue-title { font-size: 13px; }
  .issue-labels { display: flex; gap: 6px; flex-wrap: wrap; }
  .label-chip {
    font-size: 10px; padding: 1px 8px; border-radius: 999px;
    background: rgba(99, 102, 241, 0.18);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  /* Contributors */
  .contrib-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .contrib-row { display: flex; gap: 12px; align-items: center; }
  .contrib-avatar { width: 28px; height: 28px; border-radius: 50%; }
  .contrib-avatar.placeholder { background: rgba(148, 163, 184, 0.18); }
  .contrib-info { flex: 1; }
  .contrib-name { font-size: 13px; }
  .contrib-bar {
    margin-top: 4px; height: 4px;
    background: rgba(148, 163, 184, 0.18);
    border-radius: 999px;
    overflow: hidden;
  }
  .contrib-bar > span {
    display: block; height: 100%;
    background: var(--accent); border-radius: 999px;
  }
  .contrib-meta { font-size: 11px; color: var(--ink-2); }

  /* Manifest */
  .manifest-panel { padding: 18px 22px; }
  .manifest-panel.is-missing { border-left: 3px solid #F59E0B; }
  .manifest-head {
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer;
  }
  .manifest-head h3 { margin: 0; display: flex; gap: 8px; align-items: center; font-size: 16px; }
  .manifest-valid {
    font-size: 11px; color: #22C55E;
    padding: 2px 10px; border-radius: 999px;
    background: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .manifest-toggle { font-size: 12px; color: var(--ink-2); }
  .manifest-json {
    background: rgba(0,0,0,0.25);
    padding: 14px;
    border-radius: 10px;
    overflow-x: auto;
    font-size: 12px;
    margin-top: 12px;
    max-height: 480px;
  }
  .manifest-copy {
    margin-top: 10px;
    padding: 6px 14px;
    border-radius: 8px;
    background: var(--accent);
    color: white;
    border: none;
    cursor: pointer;
    font-size: 13px;
  }

  /* Rollback */
  .rollback-helper { padding: 18px 22px; }
  .rollback-hint { font-size: 13px; color: var(--ink-2); margin: 8px 0 14px; }
  .rollback-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .rollback-row label { flex: 1 1 220px; display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--ink-2); }
  .rollback-row select {
    background: rgba(255,255,255,0.06);
    color: var(--ink);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .rollback-warn {
    display: flex; gap: 8px; align-items: center;
    padding: 8px 12px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 8px;
    color: #FCA5A5;
    font-size: 13px;
    margin: 8px 0;
  }
  .rollback-cmd {
    width: 100%;
    min-height: 100px;
    background: rgba(0,0,0,0.3);
    color: #67E8F9;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 12px;
    font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
    font-size: 12px;
    line-height: 1.6;
  }
  .rollback-copy {
    margin-top: 10px;
    padding: 8px 16px;
    border-radius: 8px;
    background: var(--accent);
    color: white;
    border: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
  }
  .rollback-copy:disabled {
    background: rgba(148, 163, 184, 0.18);
    color: var(--ink-2);
    cursor: not-allowed;
  }
  .rollback-policy { font-size: 12px; color: var(--ink-2); margin-top: 12px; }

  .muted { color: var(--ink-2); font-size: 13px; }
</style>