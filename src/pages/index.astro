---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);
---

<BaseLayout activeNav="/">
  <div class="portfolio-home">
    <section class="intro">
      <h1>你好，我是 KBber。</h1>
      <p class="intro-description">
        我主要写 Python，做财报解析、文档问答和多轮对话相关的项目。
        这里放代码和实验记录，偶尔也写些笔记、放几张照片。
      </p>
      <div class="intro-actions">
        <a class="primary-action" href="/projects/">看看项目</a>
        <a class="secondary-action" href="https://github.com/KBber">GitHub</a>
      </div>
    </section>

    <section class="work-section" aria-labelledby="work-heading">
      <div class="section-heading">
        <h2 id="work-heading">最近的项目</h2>
        <a href="/projects/">全部项目</a>
      </div>
      <div class="work-grid">
        {projects.filter((project) => project.featured).map((project) => (
          <a class="work-card" href={project.href}>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="work-stack">{project.stack.join(' / ')}</div>
            <span class="repo-name">{project.name}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="writing-section" aria-labelledby="writing-heading">
      <div class="section-heading">
        <h2 id="writing-heading">最近的文章</h2>
        <a href="/posts/">全部文章</a>
      </div>
      <div class="writing-list">
        {posts.map((post) => (
          <a href={`/posts/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                timeZone: 'Asia/Shanghai',
              })}
            </time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
