---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ClockGreeting from '@components/ClockGreeting.astro';
import WeatherCard from '@components/WeatherCard.astro';
import MagneticCardStack from '@components/MagneticCardStack';
import Galaxy from '@components/Galaxy';
import SITE_CONFIG from '../../site.config';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);

const moments = (await getCollection('moments'))
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate)
  .slice(0, 3);

const featuredProjects = [
  {
    id: 'tenderguard',
    title: 'TenderGuard v0.3',
    subtitle: 'Evidence-Grounded · Rule-Governed Tender Compliance',
    body: 'LLM 理解招标文件 + Codeified Rule Engine + Evidence Pipeline + Human Review。61 条 CK、17 个确定性算子、AuditReport 三级 trace。',
    href: 'https://github.com/KBber/tenderguard',
    accent: '#06B6D4',
    tags: ['Agent', 'Rule Engine', 'Pydantic'],
  },
  {
    id: 'pd-grpo',
    title: 'pd-grpo',
    subtitle: 'Nash Equilibrium via GRPO on Iterated Prisoner’s Dilemma',
    body: '用 GRPO 微调 Qwen2-0.5B，从 Tit-for-Tat 老好人收敛到 Always-Defect 理性人，300 步全训练过程 + 5 张数据图。',
    href: 'https://github.com/KBber/pd-grpo',
    accent: '#7C3AED',
    tags: ['GRPO', 'RL', 'PyTorch'],
  },
  {
    id: 'graphrag',
    title: 'graphrag-financial-report',
    subtitle: 'Typed GraphRAG over Chinese Annual Reports',
    body: 'DeepSeek 三元组抽取 → Neo4j 知识图谱 → Leiden 社区检测 → Local/Global Search 双模式检索与对比评测。',
    href: 'https://github.com/KBber/graphrag-financial-report',
    accent: '#0EA5E9',
    tags: ['GraphRAG', 'Neo4j', 'RAG'],
  },
  {
    id: 'react-llm-memory',
    title: 'react-llm-memory-agent',
    subtitle: 'ReAct Agent with Persistent Short-Term Memory',
    body: 'ReAct 双实现对比 + 实体追踪 + 指代消解 + 36 个单元测试 + 端到端集成，金融年报多轮对话问答场景。',
    href: 'https://github.com/KBber/react-llm-memory-agent',
    accent: '#22C55E',
    tags: ['ReAct', 'Memory', 'Anaphora'],
  },
];

const pillars = [
  {
    icon: '🧠',
    title: 'Agent Systems',
    body: '把论文里 ReAct / Tool-Use / Memory 真正搬进可运行的系统：投标合规、财报问答、对话记忆。',
  },
  {
    icon: '🪄',
    title: 'LLM Engineering',
    body: '结构化抽取 · GraphRAG · 上下文检索 · LoRA SFT · 规则引擎兜底 — 让 LLM 在工程上可控、可审、可回滚。',
  },
  {
    icon: '🎯',
    title: 'Reinforcement Learning',
    body: 'GRPO / RLHF 微调小模型；在博弈 / 决策场景里观察策略涌现，从实验里读懂对齐与推理。',
  },
];

const nowItems = [
  {
    id: 'now-1',
    title: '🧪 在做',
    body: 'TenderGuard v0.3 的 retrieval 升级（BM25 + 向量 + rerank），把 decision_accuracy 推上 0.75+。',
    href: 'https://github.com/KBber/tenderguard',
    accent: '#06B6D4',
  },
  {
    id: 'now-2',
    title: '📚 在读',
    body: '《深入理解 AI Agent：设计原理与工程实践》— 第 3 章双层记忆配套实现见 contextual-retrieval-for-user-memory。',
    href: 'https://github.com/KBber/ai-agent-book',
    accent: '#7C3AED',
  },
  {
    id: 'now-3',
    title: '🛠 在写',
    body: '把 pd-grpo 的训练曲线与工程翻车沉淀成可复现的 note，欢迎一起复刻实验。',
    href: '/posts',
    accent: '#0EA5E9',
  },
];
---

<BaseLayout title="" activeNav="/">
  <Galaxy client:only="react" />
  <section class="hero">
    <div class="hero-card liquid-glass">
      <span class="liquid-glass-pill">AI Engineer · Agents · LLMs · RL</span>
      <h1 class="hero-greeting">Hi, I'm {SITE_CONFIG.profile.displayName} 👋</h1>
      <p class="hero-tagline">
        我做 <strong>Agent 系统</strong>、<strong>LLM 应用工程</strong> 与
        <strong>强化学习微调</strong>；偏好把论文变成能跑、能测、能上线的系统。
      </p>
      <p class="hero-meta">
        📍 Earth · 🐍 Python first · ☕ coffee-driven debugging
      </p>
      <div class="hero-cta">
        <a class="cta cta-primary" href="/projects">→ 看看我的项目</a>
        <a class="cta cta-ghost" href="/dashboard">📊 Git 仪表盘</a>
        <a class="cta cta-ghost" href="/about">关于我</a>
      </div>
    </div>

    <div class="widgets-row">
      <WeatherCard />
      <MagneticCardStack items={nowItems} client:load />
    </div>

    <!-- Research Pillars -->
    <section>
      <h2 class="section-title">// 三大主线</h2>
      <div class="pillar-grid">
        {pillars.map((p) => (
          <article class="liquid-glass pillar-card">
            <div class="pillar-icon">{p.icon}</div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Featured Projects -->
    <section>
      <h2 class="section-title">// Featured Builds</h2>
      <div class="project-grid">
        {featuredProjects.map((p) => (
          <a class="liquid-glass project-card" href={p.href} target="_blank" rel="noopener"
             style={`--accent: ${p.accent};`}>
            <div class="project-head">
              <h3>{p.title}</h3>
              <div class="project-tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
            <p class="project-sub">{p.subtitle}</p>
            <p class="project-body">{p.body}</p>
            <span class="project-link">GitHub ↗</span>
          </a>
        ))}
      </div>
      <p style="margin-top: 12px; text-align: right;">
        <a href="/projects" style="color: var(--accent-soft)">查看全部项目 →</a>
      </p>
    </section>

    <!-- Recent Writing -->
    <section>
      <h2 class="section-title">// 最近文章</h2>
      <div class="card-grid">
        {posts.map((p) => (
          <a class="entry-card liquid-glass" href={`/posts/${p.id}/`}>
            <div class="meta">
              <time datetime={p.data.pubDate.toISOString()}>
                {p.data.pubDate.toLocaleDateString('zh-CN')}
              </time>
              {p.data.tags.slice(0, 1).map((t) => <span class="tag">{t}</span>)}
            </div>
            <h3>{p.data.title}</h3>
            <p class="summary">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Moments -->
    <section>
      <h2 class="section-title">// 最近随笔</h2>
      <div class="liquid-glass" style="padding: 18px 22px;">
        <ul class="timeline" style="margin: 0; padding-left: 28px; list-style: none;">
          {moments.map((m) => (
            <li class="timeline-item">
              <time datetime={m.data.pubDate.toISOString()}>
                {m.data.pubDate.toLocaleDateString('zh-CN')}
                {m.data.mood && ` · ${m.data.mood}`}
              </time>
              <p>{m.body}</p>
            </li>
          ))}
        </ul>
        <p style="margin-top: 14px; text-align: right;">
          <a href="/moments" style="color: var(--accent-soft)">查看全部 →</a>
        </p>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .hero-cta {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  .cta {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .cta-primary {
    background: var(--accent);
    color: white;
    border: 1px solid transparent;
  }
  .cta-primary:hover { transform: translateY(-1px); }
  .cta-ghost {
    border: 1px solid var(--card-border);
    color: var(--ink);
  }
  .cta-ghost:hover { background: rgba(255,255,255,0.06); }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }
  .pillar-card {
    padding: 18px 20px;
    border-radius: 16px;
  }
  .pillar-icon { font-size: 26px; margin-bottom: 8px; }
  .pillar-card h3 { font-size: 16px; margin-bottom: 6px; }
  .pillar-card p { color: var(--ink-2); font-size: 14px; line-height: 1.6; }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .project-card {
    display: block;
    padding: 18px 20px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    border-left: 3px solid var(--accent, var(--accent-soft));
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }
  .project-head h3 { font-size: 17px; margin: 0; }
  .project-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.18);
    color: var(--ink-2);
    border: 1px solid rgba(148, 163, 184, 0.25);
  }
  .project-sub {
    color: var(--ink-2);
    font-size: 13px;
    margin: 4px 0 8px;
  }
  .project-body {
    color: var(--ink);
    font-size: 14px;
    line-height: 1.55;
  }
  .project-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    color: var(--accent-soft);
  }
</style>