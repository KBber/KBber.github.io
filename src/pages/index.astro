---
import BaseLayout from '@layouts/BaseLayout.astro';
import upper from '../../assets/plates/upper-gold-arc.png';
import lower from '../../assets/plates/lower-gold-arc.png';
import left from '../../assets/plates/left-gold-arc.png';
import leftLower from '../../assets/plates/left-lower-arc.png';
import caseButton from '../../assets/plates/case-button-material.png';
import sourceButton from '../../assets/plates/source-button-material.png';
import preview from '../../assets/plates/finverify-view.png';
import memory from '../../assets/projects/memory-comparison.svg?url';
import { homeProjects } from '../data/home-projects';
---
<BaseLayout home activeNav="/projects">
  <section class="case-hero" aria-labelledby="home-project-title" data-home-project style={`--button-material: url("${caseButton.src}")`}>
    <img class="hero-art art-upper" src={upper.src} alt="" width={upper.width} height={upper.height} fetchpriority="high" />
    <img class="hero-art art-lower" src={lower.src} alt="" width={lower.width} height={lower.height} />
    <img class="hero-art art-left" src={left.src} alt="" width={left.width} height={left.height} />
    <img class="hero-art art-left-lower" src={leftLower.src} alt="" width={leftLower.width} height={leftLower.height} />
    <img class="material case-material" src={caseButton.src} alt="" width={caseButton.width} height={caseButton.height} />
    <img class="material source-material" src={sourceButton.src} alt="" width={sourceButton.width} height={sourceButton.height} />
    <div class="project-window" id="home-project-preview">
      <img id="preview-finverify" class="project-image" src={preview.src} alt="finverify 演示报告，左侧为校验结果，右侧显示对应 PDF 原文。" width={preview.width} height={preview.height} loading="eager" />
      <img id="preview-memory" class="project-image project-diagram" src={memory} alt="ReAct 项目提供的多轮对话对照图。" hidden />
      <div id="preview-graphrag" class="graph-preview" hidden>
        <h2>年报知识图谱</h2>
        <p>实现结构：从年报提取实体和关系，存入 Neo4j。</p>
        <div class="graph-flow"><span>年报段落</span><span>实体与关系</span><span>知识图谱</span></div>
        <div class="search-modes"><div><h3>Local Search</h3><p>围绕实体查询相关信息。</p></div><div><h3>Global Search</h3><p>结合社区信息回答综合问题。</p></div></div>
        <p class="preview-note">项目实现结构</p>
      </div>
    </div>
    <canvas class="sand-motion" aria-hidden="true" data-sand-canvas></canvas>
    <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false">暂停背景动效</button>
    <h1 class="home-project-title" id="home-project-title">finverify</h1>
    <p class="home-project-subtitle" id="home-project-subtitle">财报数字溯源与校验</p>
    <p class="home-project-copy" id="home-project-copy">从财报 PDF 中抽取数字，<br />保留页码和坐标。<br />按会计勾稽关系校验，<br />证据不足时人工复核。</p>
    <a class="hero-action action-case btn" id="home-case-link" href="/projects/finverify/">
      <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="7"/><circle cx="18" cy="18" r="12" stroke-dasharray="2 4"/></svg>
      <span>查看案例</span>
    </a>
    <a class="hero-action action-source btn" id="home-source-link" href="https://github.com/KBber/finverify">
      <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="7"/><circle cx="18" cy="18" r="12" stroke-dasharray="2 4"/></svg>
      <span>查看源码</span>
    </a>
    <div class="pipeline" role="group" aria-label="项目处理流程">
      <span class="pipeline-line" aria-hidden="true"></span>
      <button class="pipeline-step step-first" type="button" aria-pressed="false" data-step="0">PDF</button>
      <button class="pipeline-step step-second" type="button" aria-pressed="true" data-step="1">提取</button>
      <button class="pipeline-step step-third" type="button" aria-pressed="false" data-step="2">校验</button>
    </div>
    <p class="stage-source" id="home-stage-message" aria-live="polite">保留页码和坐标</p>
    <p class="stage-review" id="home-stage-review">证据不足时人工复核</p>
    <h2 class="related-heading">其他项目</h2>
    <button class="related-project related-first btn btn--secondary" type="button" data-project="1">
      <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="6"/><circle cx="16" cy="16" r="12"/></svg>
      <span>年报问答</span>
    </button>
    <button class="related-project related-second btn btn--secondary" type="button" data-project="2">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m5 10 11-6 11 6-11 6-11-6Zm0 7 11 6 11-6M5 23l11 6 11-6"/></svg>
      <span>会话记忆</span>
    </button>
    <button class="next-project" type="button" id="home-next-project">
      <span class="next-label">下一案例</span>
      <span class="next-name">graphrag-financial-report</span>
      <span class="next-description">基于图检索的财报问答</span>
    </button>
  </section>
  <script is:inline define:vars={{ projects: homeProjects }}>
    const root = document.querySelector('[data-home-project]');
    const steps = [...root.querySelectorAll('[data-step]')];
    const related = [...root.querySelectorAll('[data-project]')];
    const next = document.getElementById('home-next-project');
    let current = 0;
    function showStep(index) {
      steps.forEach((button, position) => button.setAttribute('aria-pressed', String(position === index)));
      document.getElementById('home-stage-message').textContent = projects[current].messages[index];
    }
    function showProject(index) {
      current = index;
      const project = projects[current];
      document.getElementById('home-project-title').textContent = project.displayName;
      document.getElementById('home-project-subtitle').textContent = project.homeTitle;
      document.getElementById('home-project-copy').textContent = project.homeDescription;
      document.getElementById('home-case-link').href = '/projects/' + project.name + '/';
      document.getElementById('home-source-link').href = project.href;
      document.getElementById('home-stage-review').textContent = project.review;
      root.dataset.activeProject = project.preview;
      ['finverify', 'graphrag', 'memory'].forEach((id) => {
        document.getElementById('preview-' + id).hidden = id !== project.preview;
      });
      steps.forEach((button, position) => { button.textContent = project.stages[position]; });
      const others = projects.map((entry, position) => ({ entry, position })).filter(({position}) => position !== current);
      related.forEach((button, position) => {
        button.dataset.project = String(others[position].position);
        button.querySelector('span').textContent = others[position].entry.shortTitle;
      });
      const nextProject = projects[(current + 1) % projects.length];
      next.querySelector('.next-name').textContent = nextProject.name;
      next.querySelector('.next-description').textContent = nextProject.homeTitle;
      showStep(1);
      document.getElementById('home-project-title').setAttribute('aria-live', 'polite');
    }
    steps.forEach((button) => button.addEventListener('click', () => showStep(Number(button.dataset.step))));
    related.forEach((button) => button.addEventListener('click', () => showProject(Number(button.dataset.project))));
    next.addEventListener('click', () => showProject((current + 1) % projects.length));
  </script>
  <script>
    import '../scripts/sand-motion';
  </script>
</BaseLayout>
