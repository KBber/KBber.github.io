{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbber.github.io/schemas/project-context.schema.json",
  "title": "KBber Project Context",
  "description": "AI-readable contract for KBber repositories. Any agent can fetch raw.githubusercontent.com/KBber/<repo>/main/PROJECT_CONTEXT.json and immediately understand state, update policy, rollback policy, and pre-baked prompts.",
  "type": "object",
  "required": ["schema_version", "name", "slug", "owner", "summary", "stack", "state", "ai_instructions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Bump on breaking changes; loader rejects mismatches."
    },
    "name":           { "type": "string", "description": "Display name shown in dashboard cards." },
    "slug":           { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "owner":          { "type": "string", "const": "KBber" },
    "summary":        { "type": "string", "maxLength": 280 },
    "tags":           { "type": "array", "items": { "type": "string" }, "default": [] },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages":  { "type": "array", "items": { "type": "string" }, "default": [] },
        "frameworks": { "type": "array", "items": { "type": "string" }, "default": [] },
        "infra":      { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "state": {
      "type": "object",
      "required": ["default_branch", "last_commit_sha", "last_commit_at"],
      "additionalProperties": false,
      "properties": {
        "default_branch":     { "type": "string" },
        "last_commit_sha":    { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "last_commit_at":     { "type": "string", "format": "date-time" },
        "protected_branches": { "type": "array", "items": { "type": "string" }, "default": [] },
        "open_issues_count":  { "type": "integer", "minimum": 0, "default": 0 },
        "releases":           { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "ai_instructions": {
      "type": "object",
      "required": ["update_policy", "rollback_policy", "prompts"],
      "additionalProperties": false,
      "properties": {
        "update_policy": {
          "type": "string",
          "enum": ["auto-merge-patch", "pr-required", "manual-only", "read-only"]
        },
        "rollback_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_strategy": {
              "type": "string",
              "enum": ["revert", "reset-hard", "revert-and-tag", "new-release"]
            },
            "require_confirmation": { "type": "boolean", "default": true }
          }
        },
        "aliases": {
          "type": "object",
          "description": "Map commit-author emails to canonical display names.",
          "additionalProperties": { "type": "string" }
        },
        "prompts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summarize": { "type": "string" },
            "next_step": { "type": "string" },
            "rollback":  { "type": "string" }
          }
        }
      }
    }
  }
}